{
  "metadata": {
    "description": "Fictional supplier agreement examples for the renewal-risk demo.",
    "asOfDate": "2026-07-01",
    "reviewWindowDays": 120,
    "sourceDirectory": "examples/agreements"
  },
  "examples": [
    {
      "file": "examples/agreements/brightline-office-supplies.md",
      "scenario": "Auto-renewing agreement over $50k requiring review",
      "agreement": {
        "agreementId": "demo-brightline-001",
        "supplierName": "Brightline Office Supplies LLC",
        "agreementTitle": "Workplace Supplies Subscription Agreement",
        "agreementValue": 82000,
        "currency": "USD",
        "renewalType": "auto_renews",
        "renewalDate": "2026-10-15",
        "noticePeriodDays": 60,
        "noticeDeadline": "2026-08-16"
      },
      "expectedFinding": {
        "classification": "needs_review",
        "recommendedAction": "owner_review",
        "daysUntilNoticeDeadline": 46,
        "keyExtractionSignals": [
          "Agreement auto-renews.",
          "Agreement value is at or above 50000 USD."
        ]
      }
    },
    {
      "file": "examples/agreements/meridian-catering-services.md",
      "scenario": "Notice deadline within 30 days",
      "agreement": {
        "agreementId": "demo-meridian-002",
        "supplierName": "Meridian Catering Services Inc.",
        "agreementTitle": "Event Catering Services Agreement",
        "agreementValue": 42000,
        "currency": "USD",
        "renewalType": "auto_renews",
        "renewalDate": "2026-08-19",
        "noticePeriodDays": 30,
        "noticeDeadline": "2026-07-20"
      },
      "expectedFinding": {
        "classification": "urgent",
        "recommendedAction": "owner_review",
        "daysUntilNoticeDeadline": 19,
        "keyExtractionSignals": [
          "Agreement auto-renews.",
          "Notice deadline is within 30 days."
        ]
      }
    },
    {
      "file": "examples/agreements/northstar-maintenance-group.md",
      "scenario": "Notice deadline already passed",
      "agreement": {
        "agreementId": "demo-northstar-003",
        "supplierName": "Northstar Maintenance Group LLC",
        "agreementTitle": "Facilities Maintenance Agreement",
        "agreementValue": 48000,
        "currency": "USD",
        "renewalType": "auto_renews",
        "renewalDate": "2026-07-20",
        "noticePeriodDays": 45,
        "noticeDeadline": "2026-06-05"
      },
      "expectedFinding": {
        "classification": "blocked",
        "recommendedAction": "escalate_missed_deadline",
        "daysUntilNoticeDeadline": -26,
        "keyExtractionSignals": [
          "Agreement auto-renews.",
          "Notice deadline has already passed."
        ]
      }
    },
    {
      "file": "examples/agreements/atlas-calibration-labs.md",
      "scenario": "High-value manual renewal with complete notice terms",
      "agreement": {
        "agreementId": "demo-atlas-004",
        "supplierName": "Atlas Calibration Labs Inc.",
        "agreementTitle": "Equipment Calibration Services Agreement",
        "agreementValue": 96000,
        "currency": "USD",
        "renewalType": "manual_renewal",
        "renewalDate": "2026-09-30",
        "noticePeriodDays": 45,
        "noticeDeadline": "2026-08-16"
      },
      "expectedFinding": {
        "classification": "standard",
        "recommendedAction": "no_action",
        "daysUntilNoticeDeadline": 46,
        "keyExtractionSignals": [
          "Agreement value is at or above 50000 USD."
        ]
      }
    },
    {
      "file": "examples/agreements/clearview-inventory-platform.md",
