{
  "name": "docusign-renewal-risk-agent",
  "version": "0.1.0",
  "description": "Mastra multi-agent demo for supplier renewal risk using Docusign Agreement Manager intelligence.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:policy",
    "test:policy": "node --import tsx --test src/mastra/tools/portfolio-tools.test.ts src/mastra/tools/follow-up-tools.test.ts",
    "build:agreements": "node scripts/build-agreements.mjs",
    "dev": "MASTRA_AUTO_DETECT_URL=true mastra dev",
    "preview:app": "next dev -H 0.0.0.0 -p 4173",
    "preview:build": "next build",
    "preview:start": "next start -H 127.0.0.1 -p 4173",
    "auth:docusign": "node scripts/docusign-auth.mjs",
    "inspect:mcp": "tsx scripts/inspect-mcp.ts",
    "build": "mastra build && next build",
    "start": "mastra start"
  },
  "keywords": [
    "docusign",
    "agreement-manager",
    "mcp",
    "mastra",
    "agents",
    "renewals"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "^1.49.0",
    "@mastra/duckdb": "^1.5.0",
    "@mastra/libsql": "^1.15.0",
    "@mastra/loggers": "^1.2.0",
    "@mastra/mcp": "^1.13.0",
    "@mastra/memory": "^1.22.1",
    "@mastra/observability": "^1.15.2",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "mastra": "^1.18.0",
    "pdfkit": "^0.19.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
