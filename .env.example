# LLM key for the Intake and Risk Review agents (both run on an OpenAI model).
# Not needed for fixture-mode runs or the policy tests.
OPENAI_API_KEY=your-api-key

# Server-side URL used by the Next.js preview API to invoke Mastra workflows.
MASTRA_API_URL=http://127.0.0.1:4111/api

# Docusign MCP integration.
DOCUSIGN_ENVIRONMENT=demo
DOCUSIGN_MCP_URL=https://mcp-d.docusign.com/mcp
DOCUSIGN_ACCOUNT_ID=your-docusign-account-id
DOCUSIGN_CLIENT_ID=your-docusign-integration-key
DOCUSIGN_CLIENT_SECRET=your-docusign-secret-key
DOCUSIGN_OAUTH_REDIRECT_URI=http://localhost:4111/auth/docusign/callback

DOCUSIGN_MCP_ACCESS_TOKEN=
DOCUSIGN_MCP_REFRESH_TOKEN=
DOCUSIGN_MCP_SCOPE=adm_store_unified_repo_read aow_manage manage_app_keys signature

# Optional: override the OAuth host used by `npm run auth:docusign`.
# Defaults to the demo/production host derived from DOCUSIGN_ENVIRONMENT.
# DOCUSIGN_AUTH_BASE_URL=https://account-d.docusign.com

# Optional Workflow Builder follow-up after human approval.
DOCUSIGN_WORKFLOW_ID=your-workflow-builder-workflow-id
DOCUSIGN_WORKFLOW_NAME=Renewal Risk Follow-Up
DOCUSIGN_WORKFLOW_REVIEWER_EMAIL=reviewer@example.com
DOCUSIGN_WORKFLOW_PREPARER_EMAIL=preparer@example.com
